# ==============================================================================
# Steam Games RAG Environment Configuration
# ==============================================================================

# LLM Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_RPM=30

# Observability & Tracing (Langfuse)
# For local self-hosted instance: http://localhost:3000 (or http://langfuse-server:3000 inside Docker)
# For Langfuse Cloud: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=http://langfuse-server:3000

# Vector Database (Qdrant)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=steam_games

# Data & Prompt Paths
STEAM_CSV_PATH=/app/data/steam_games.csv
PROMPT_REGISTRY_PATH=/app/prompts/registry.yaml
CANONICAL_CATALOG_PATH=/app/data/canonical_values.json
INDEX_STATE_PATH=/app/data/indexing_state.json

# Embedding Models
DENSE_EMBEDDING_MODEL=intfloat/multilingual-e5-large
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
DENSE_VECTOR_SIZE=1024

# Batch & Performance Tuning
EMBEDDING_BATCH_SIZE=16
INGESTION_BATCH_SIZE=64
RETRIEVAL_TEXT_MAX_CHARS=3000
RESULT_LIMIT=10

# Search Deadlines & Timeouts (seconds)
SEARCH_SOFT_DEADLINE_SECONDS=10
SEARCH_HARD_DEADLINE_SECONDS=15
QDRANT_STARTUP_TIMEOUT_SECONDS=60

# Logging & Security
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://steam.constantine.software
