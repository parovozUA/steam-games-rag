GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-5.6-luna
GEMINI_RPM=30
OPENAI_RPM=30

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=steam_games
STEAM_CSV_PATH=/app/data/steam_games.csv
PROMPT_REGISTRY_PATH=/app/prompts/registry.yaml
CANONICAL_CATALOG_PATH=/app/data/canonical_values.json
INDEX_STATE_PATH=/app/data/indexing_state.json

DENSE_EMBEDDING_MODEL=BAAI/bge-m3
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
DENSE_VECTOR_SIZE=1024
EMBEDDING_BATCH_SIZE=16
INGESTION_BATCH_SIZE=64
RETRIEVAL_TEXT_MAX_CHARS=3000

DENSE_TOP_K=50
SPARSE_TOP_K=50
FUSION_TOP_K=30
RERANK_CANDIDATES=20
RESULT_LIMIT=10
DENSE_WEIGHT=0.65
BM25_WEIGHT=0.35
RRF_K=60

SEARCH_SOFT_DEADLINE_SECONDS=10
SEARCH_HARD_DEADLINE_SECONDS=15
QDRANT_STARTUP_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,https://test.constantine.software
